---
import Gtm from '../components/shared/Gtm.astro';
import GtmBody from '../components/shared/GtmBody.astro';
import Maps from '../components/shared/Maps.astro';

interface Props {
  title: string;
  ogTitle: string;
  description: string;
  ogDescription: string;
  keywords: string;
  ogType?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  publishedTime?: string;
}

const {
  title,
  ogTitle,
  description,
  ogDescription,
  keywords,
  ogType = 'website',
  ogImage = 'https://labstudiomedia.com/pageView.webp',
  ogImageWidth = 1902,
  ogImageHeight = 1080,
  ogImageAlt = ogTitle,
  publishedTime,
} = Astro.props;

const canonicalUrl = `https://labstudiomedia.com${Astro.url.pathname}`;
---

<!doctype html>
<html lang="es">
  <head>
    <Gtm />
    <Maps />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-mx" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta
      name="google-site-verification"
      content="O5K-700LvgkrdOo5Ir4cyfOGDaastTK5-TNAC-4utPo"
    />
    <meta property="og:title" content={ogTitle} />
    <meta name="description" content={description} />
    <meta property="og:description" content={ogDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="LabStudioMedia" />
    <meta property="og:author" content="LabStudioMedia" />
    <meta property="og:site_name" content="LABSTUDIO | Soluciones Digitales" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      itemprop="image primaryImageOfPage"
      content={ogImage}
    />
    <meta property="og:image:width" content={`${ogImageWidth}`} />
    <meta property="og:image:height" content={`${ogImageHeight}`} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="shortcut icon" type="icon" href="/favicon/favicon.ico" />
    <link rel="icon" href="/favicon/32x32.png" sizes="32x32">
    <link rel="icon" href="/favicon/48x48.png" sizes="48x48">
    <link rel="icon" href="/favicon/96x96.png" sizes="96x96">
    <link rel="icon" href="/favicon/144x144.png" sizes="144x144">
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <link rel="stylesheet" href="/styles/theme.bundle.css" />
    <link rel="stylesheet" href="/styles/libs.bundle.css" />
    <link rel="stylesheet" href="/styles/shared.css" />
  </head>
  <body>
    <GtmBody />
    <slot />
  </body>
  <script is:inline src="/js/theme.bundle.js" defer></script>
  <script is:inline src="/js/vendor.bundle.js" defer></script>
</html>
