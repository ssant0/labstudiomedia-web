---
import type { Author } from "../../data/authors";

interface Props {
  author: Author;
}

const { author } = Astro.props;
---

<aside class="author-bio" aria-label="Sobre el autor" data-aos="fade-up">
  <div class="author-bio-avatar" aria-hidden="true">{author.initials}</div>
  <div class="author-bio-info">
    <p class="author-bio-eyebrow mb-1">Escrito por</p>
    <p class="author-bio-name h5 fw-bold mb-1">{author.name}</p>
    <p class="author-bio-role mb-2">{author.role}</p>
    <p class="author-bio-text mb-3">{author.bio}</p>
    <a
      class="author-bio-linkedin"
      href={author.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Perfil de LinkedIn de ${author.name}`}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        fill="currentColor"
        viewBox="0 0 16 16"
        aria-hidden="true"
      >
        <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.633 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"></path>
      </svg>
      <span>LinkedIn</span>
    </a>
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
    margin-top: 3rem;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background: #fafafa;
    border: 1px solid rgba(99, 63, 185, 0.12);
  }

  .author-bio-avatar {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    background: linear-gradient(135deg, #9554fd 0%, #4e2fa8 100%);
    box-shadow: 0 12px 30px rgba(99, 63, 185, 0.28);
  }

  .author-bio-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9554fd;
  }

  .author-bio-name {
    color: #1a1a2e;
  }

  .author-bio-role {
    color: #9554fd;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .author-bio-text {
    color: #6b5f85;
    margin: 0;
  }

  .author-bio-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #633fb9;
    background: #f5f0ff;
    border: 1px solid rgba(99, 63, 185, 0.14);
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .author-bio-linkedin svg {
    width: 16px;
    height: 16px;
  }

  .author-bio-linkedin:hover {
    color: #fff;
    background: linear-gradient(82deg, #9554fd 0%, #7645ed 100%);
    transform: translateY(-2px);
  }

  @media (max-width: 576px) {
    .author-bio {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .author-bio-info {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
