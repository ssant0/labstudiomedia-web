---
import BlogEntryCard from "../components/blog/BlogEntryCard.astro";
import Footer from "../components/shared/Footer.astro";
import Nav from "../components/shared/Nav.astro";
import SubPageLayout from "../layouts/SubPageLayout.astro";
import { blogPosts, slugify } from "../data/blogPosts";

const itemListSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Blog de LabStudio Media",
  itemListElement: blogPosts.map((post, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `https://labstudiomedia.com/blog/${slugify(post.title)}`,
    name: post.title,
  })),
});
---

<SubPageLayout
title="LABSTUDIO | Blog de Soluciones Digitales para Negocios"
ogTitle="LABSTUDIO | Blog de Soluciones Digitales"
description="Ideas, consejos y tendencias sobre soluciones digitales para negocios: desarrollo web, diseño, branding y presencia digital. Aprende a hacer crecer tu marca en línea."
ogDescription="Blog de LabStudio Media: artículos sobre desarrollo web, diseño, branding y presencia digital para negocios en Los Mochis, Sinaloa y todo México."
keywords="blog soluciones digitales, desarrollo web, diseño web, branding, presencia digital, tarjetas NFC, consejos web para negocios, Los Mochis, Sinaloa"
breadcrumbName="Blog"
>
  <script type="application/ld+json" slot="head" set:html={itemListSchema} />
  <Nav />

  <main class="w-100 d-flex flex-column align-items-center pb-12">
    <div class="blog-container">
      <h1>Bienvenido a nuestro Blog: Innovación, Consejos y Estrategias de Soluciones Digitales</h1>

      <div class="d-flex flex-wrap pt-6 gap-control">
        {blogPosts.map((post) => (
          <BlogEntryCard
            title={post.title}
            description={post.description}
            image={post.image}
          />
        ))}
      </div>
    </div>
  </main>

  <Footer
    useMap={false}
  />
</SubPageLayout>

<script>

  const titlesList: NodeListOf<HTMLHeadingElement> = document.querySelectorAll('h2');

  // this function reconfigures the title of each card cutting the string for no text overlap in cards, cut in front-end for no lose SEO
  const fixCardsTitle = (onCutLength: number) => {
    titlesList.forEach(title => {
      let processedTitle: string = title.textContent;
      let beCut: boolean = false;

      if (processedTitle.length > (onCutLength)) {
        beCut = true;
        processedTitle = processedTitle.substring(0, onCutLength - 3);
      }

      if (processedTitle.endsWith(' ')) {
        processedTitle = processedTitle.substring(0, processedTitle.length - 1);
      }

      if (beCut) {
        processedTitle += '...';
      }

      title.textContent = processedTitle;
    });
  }

  if (window.innerWidth <= 857) {
    fixCardsTitle(57);
  }

  if (window.innerWidth <= 698) {
    fixCardsTitle(52);
  }

  if (window.innerWidth <= 643) {
    fixCardsTitle(46);
  }

  if (window.innerWidth <= 578) {
    fixCardsTitle(40);
  }

  if (window.innerWidth <= 506) {
    fixCardsTitle(32);
  }

  if (window.innerWidth <= 427) {
    fixCardsTitle(28);
  }

  if (window.innerWidth <= 387) {
    fixCardsTitle(26);
  }

  if (window.innerWidth <= 361) {
    fixCardsTitle(22);
  }

</script>

<style>
  .blog-container {
    padding-top: 4rem;
    width: 800px;
  }

  h1 {
    margin: 0;
    font-size: 2.6rem;
    font-weight: 600;
  }
  
  .gap-control {
    gap: 28px;
  }

  @media only screen and (max-width: 857px) {
    .blog-container {
      width: 700px;
      padding: 2rem 1rem 0 1rem;
    }
    h1 {
      font-size: 2.2rem;
    }
  }

  @media only screen and (max-width: 707px) {
    .blog-container {
      width: 96%;
      padding: 2rem 1rem 0 1rem;
    }    
    h1 {
      font-size: 2rem;
    }
  }

  @media only screen and (max-width: 657px) {
    h1 {
      font-size: 1.8rem;
    }
  }
</style>